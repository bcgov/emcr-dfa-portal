{
  "name": "shared-workspace",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "eslint projects/ --ext .jsx,.js,.ts,.tsx",
    "lint-fix": "npm run lint -- --fix",
    "format": "prettier --loglevel=warn --check \"./projects/**/*.{js,jsx,ts,tsx,html,css,scss}\"",
    "format-fix": "prettier --loglevel=warn --write \"./projects/**/*.{js,jsx,ts,tsx,json,html,css,scss}\"",
    "fix": "npm-run-all -l -s lint-fix format-fix"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "~19.2.19",
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/material": "~19.2.19",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.15",
    "@angular/cli": "^19.2.15",
    "@angular/compiler-cli": "^19.2.0",
    "@types/jasmine": "~5.1.0",
    "@typescript-eslint/eslint-plugin": "7.11.0",
    "@typescript-eslint/parser": "7.11.0",
    "eslint": "~8.56.0",
    "eslint-config-prettier": "~8.10.0",
    "eslint-plugin-prettier": "~4.2.1",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^19.2.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.8.8",
    "prettier-plugin-organize-imports": "^3.2.4",
    "typescript": "~5.7.2"
  }
}