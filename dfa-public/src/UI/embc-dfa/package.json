{
  "name": "embc-evacuee",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run gen-api && ng serve --port 5200 --configuration=dev",
    "startlocal": "ng serve --port 5200 --configuration=local",
    "startway": "ng serve --port 5200 --configuration=local",
    "build": "ng build",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "gen-api": "ng-openapi-gen -i https://portal.dev.dfa.gov.bc.ca/api/openapi/v1/openapi.json -o ./src/app/core/api --ignoreUnusedModels false --endOfLineStyle lf",
    "gen-api-local": "ng-openapi-gen -i http://localhost:5020/api/openapi/v1/openapi.json -o ./src/app/core/api --ignoreUnusedModels false --endOfLineStyle lf",
    "format": "prettier --loglevel=warn --check \"./src/**/*.{js,jsx,ts,tsx,html,css,scss}\"",
    "format-fix": "prettier --loglevel=warn --write \"./src/**/*.{js,jsx,ts,tsx,json,html,css,scss}\""
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^18.0.1",
    "@angular/common": "^18.0.1",
    "@angular/core": "^18.0.1",
    "@angular/forms": "^18.0.1",
    "@angular/material": "^18.0.1",
    "@angular/platform-browser": "^18.0.1",
    "@angular/platform-browser-dynamic": "^18.0.1",
    "@angular/router": "^18.0.1",
    "@ng-idle/core": "^15.0.0",
    "@ng-idle/keepalive": "^15.0.0",
    "@progress/kendo-angular-common": "^16.5.0",
    "@progress/kendo-angular-icons": "^16.5.0",
    "@progress/kendo-angular-l10n": "^16.5.0",
    "@progress/kendo-angular-layout": "^16.5.0",
    "@progress/kendo-angular-progressbar": "^16.5.0",
    "@progress/kendo-licensing": "^1.3.5",
    "angular-auth-oidc-client": "^17.1.0",
    "bootstrap": "^5.3.3",
    "eslint-plugin-deprecation": "^3.0.0",
    "moment": "^2.30.1",
    "ng-recaptcha-2": "^14.0.0",
    "ngx-markdown": "^18.0.0",
    "ngx-mask": "^18.0.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.14.8"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.11",
    "@angular/cli": "^18.2.11",
    "@angular/compiler": "^18.2.11",
    "@types/jest": "^29.5.14",
    "jasmine-core": "~5.7.1",
    "jest": "^29.7.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-openapi-gen": "^0.53.0",
    "prettier": "^3.5.3",
    "prettier-plugin-organize-imports": "^3.2.4",
    "ts-node": "~10.9.2",
    "typescript": "^5.4.5"
  }
}
